/* D8R's dark stylesheet: a data IDE in the terminal.
   Theme tokens come from `textual-dark`, so the app stays dark by design. */

Screen {
    background: $background;
    layers: base;
}

/* -- header ------------------------------------------------------------- */

#header {
    height: 3;
    padding: 0 1;
    background: $panel;
}

#app-title {
    width: auto;
    padding: 1 2 0 0;
    text-style: bold;
    color: $accent;
}

#header Select {
    width: 1fr;
    max-width: 34;
    min-width: 12;
    margin: 0 1 0 0;
}

#backend-pill {
    width: auto;
    height: 1;
    margin: 1 0 0 1;
    padding: 0 2;
    background: $accent 20%;
    color: $text;
}

#reconnect-source {
    width: auto;
    min-width: 11;
    margin: 1 0 0 1;
}

/* -- body --------------------------------------------------------------- */

#body {
    height: 1fr;
}

#explorer-slot {
    width: 36;
    min-width: 0;
}

#schema-pane, #fn-list-pane {
    width: 1fr;
    height: 1fr;
}

#schema-pane Tree {
    height: 1fr;
    background: $surface;
}

#explorer-tabs, #explorer-tabs ContentSwitcher, #tab-schema, #tab-pages, #tab-agents {
    height: 1fr;
    padding: 0;
}

#schema-hint {
    height: 2;
    color: $text-muted;
}

#schema-index {
    display: none;
    height: auto;
    color: $text-muted;
}

#schema-index-dots {
    width: 4;
    height: 1;
}

#schema-index-label {
    width: 1fr;
    height: auto;
}

#page-actions, #agents-actions {
    height: 1;
}

#page-actions Button, #agents-actions Button {
    height: 1;
    min-width: 0;
    margin-right: 1;
}

#page-title {
    height: 3;
}

#pages-list {
    height: 1fr;
    border: none;
}

#pages-hint {
    height: auto;
    padding: 0 1;
    color: $text-muted;
    background: $panel-darken-1;
}

#work-bench {
    width: 1fr;
    min-width: 0;
    layers: base overlay;
}

#editor-slot {
    height: 22;
    min-height: 0;
    layers: base overlay;
}

#output-slot {
    height: 1fr;
    min-height: 0;
}

#function-editor, #function-output, #fn-list-pane {
    display: none;
}

#function-editor, #function-output {
    height: 1fr;
    min-width: 0;
}

.pane-title {
    height: 1;
    padding: 0 1;
    background: $panel-darken-1;
    color: $text-muted;
    text-style: bold;
}

/* -- editor + palette --------------------------------------------------- */

#editor-pane {
    height: 1fr;
    layers: base overlay;
}

#document-actions, #fn-actions {
    height: 1;
    background: $panel-darken-1;
}

#fn-actions .pane-title {
    width: 1fr;
}

#document-actions Button, #results-actions Button, #fn-actions Button {
    height: 1;
    min-width: 8;
    margin: 0 1 0 0;
}

#document-actions Button {
    min-width: 0;
    padding: 0;
}

#editor {
    height: 1fr;
    border: none;
    background: $surface;
}

CommandPalette {
    layer: overlay;
    position: absolute;
    /* The palette re-places itself under the caret on every keystroke; these
       are only the values it starts from and the shape it keeps. */
    offset: 1 2;
    width: 62;
    max-height: 8;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    scrollbar-size-vertical: 1;
    display: none;
    background: $panel;
    border: round $accent;
    padding: 0 1;
}

CommandPalette.open {
    display: block;
}

/* -- results ------------------------------------------------------------ */

#result-tabs {
    height: 1fr;
}

#results-actions {
    height: 1;
    padding: 0 1;
    background: $panel;
}

#results-table {
    height: 1fr;
}

#results-error {
    display: none;
    height: auto;
    padding: 0 1;
    color: $error;
    text-style: bold;
}

#results-error.error {
    display: block;
}

#results-status {
    height: 1;
    padding: 0 1;
    background: $panel-darken-1;
    color: $text-muted;
}

#sql-text {
    height: 1fr;
    border: none;
    background: $surface;
}

#history-table {
    height: 1fr;
}

/* -- footer ------------------------------------------------------------- */

#footer {
    height: 2;
    background: $panel;
}

#keymap {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#status {
    height: 1;
    padding: 0 1;
    color: $text;
    text-style: bold;
}

/* -- add-source modal --------------------------------------------------- */

AddSourceModal {
    align: center middle;
    background: $background 60%;
}

#add-source {
    width: 74;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#add-source-title {
    text-style: bold;
    color: $accent;
}

#add-source-note {
    color: $text-muted;
    padding: 0 0 1 0;
}

#d1-fields, #postgres-fields {
    height: auto;
}

#add-source .field-label {
    padding: 1 0 0 0;
    color: $text-muted;
}

#add-source-message {
    height: auto;
    padding: 1 0 0 0;
    color: $text-muted;
}

#add-source-message.error {
    color: $error;
}

#add-source-buttons {
    dock: bottom;
    background: $surface;
    height: auto;
    padding: 1 0 0 0;
}

#add-source-buttons Button {
    margin: 0 1 0 0;
}

/* -- settings ----------------------------------------------------------- */

SettingsScreen {
    align: center middle;
    background: $background;
}

#settings {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#settings-title {
    height: 1;
    text-style: bold;
    color: $accent;
}

#settings-workspace {
    height: 1fr;
    margin-top: 1;
}

#settings-sidebar-pane {
    width: 26;
    max-width: 35%;
    height: 1fr;
    padding-right: 1;
    border-right: solid $panel-lighten-2;
}

#settings-nav-title {
    height: 1;
    padding-left: 1;
    margin-bottom: 1;
    color: $text-muted;
}

#settings-sidebar {
    height: 1fr;
    background: $background;
    border: none;
}

#settings-content {
    width: 1fr;
    min-width: 0;
    height: 1fr;
    padding-left: 2;
}

#settings-heading {
    height: auto;
    text-style: bold;
    color: $accent;
}

#settings-description {
    height: auto;
    margin: 1 0;
    color: $text-muted;
}

#settings-menu {
    height: 1fr;
    background: $surface;
    border: round $panel-lighten-2;
}

#settings-menu:focus {
    border: round $accent;
}

#settings-hint {
    height: auto;
    padding: 1 0 0 0;
    color: $text-muted;
}

/* -- function library (\\fn) -------------------------------------------- */

#fn-list {
    height: 1fr;
    background: $surface;
    border: round $panel-lighten-2;
}

#fn-param-guide {
    height: 40%;
    min-height: 0;
    padding: 1;
    background: $panel;
    color: $text-muted;
}

#fn-param-guide .guide-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}


#fn-editor {
    width: 1fr;
    height: 1fr;
    padding: 0;
}

#fn-editor .field-label {
    padding: 0;
    color: $text-muted;
}

.fn-field {
    height: 1;
}

.fn-field Static {
    width: 15;
    color: $text-muted;
}

.fn-field Input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
}

#fn-status {
    height: auto;
    max-height: 3;
    color: $text-muted;
}

#fn-status.error {
    color: $error;
}

#fn-body-pane {
    /* Last row of the form: grows to fill whatever the fixed fields leave. */
    height: 1fr;
    min-height: 4;
    layers: base overlay;
}

#fn-body {
    height: 1fr;
    background: $surface;
    border: round $panel-lighten-2;
}

#fn-buttons {
    height: auto;
    padding: 0;
}

#fn-buttons Button {
    height: 1;
    min-width: 6;
    width: 1fr;
    margin: 0 1 0 0;
}

#fn-grid {
    height: 1fr;
    min-height: 0;
}

/* -- in-layout AI assistant --------------------------------------------- */

AIPanel {
    width: 44;
    min-width: 0;
    height: 1fr;
    border-left: solid $accent;
    padding: 0 1;
    background: $surface;
}

AIPanel .ai-notice {
    height: auto;
    max-height: 3;
    color: $text-muted;
}

AIPanel #ai-review {
    height: 1fr;
}

AIPanel #ai-conversation {
    height: auto;
    max-height: 50%;
    min-height: 3;
    margin-top: 1;
}

AIPanel #ai-transcript {
    height: auto;
}

AIPanel #ai-status {
    height: auto;
    max-height: 4;
    color: $text-muted;
    margin: 0;
}

AIPanel #ai-question {
    display: none;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    border: round $accent;
    background: $panel;
}

AIPanel #ai-question-text {
    height: auto;
    margin: 1 0;
    text-style: bold;
}

AIPanel #ai-question-options {
    min-height: 4;
    max-height: 16;
    border: none;
    background: $panel;
}

AIPanel #ai-question-other {
    height: 3;
    margin-top: 1;
}

AIPanel #ai-question-hint {
    height: auto;
    color: $text-muted;
}

AIPanel #ai-question-submit {
    height: 1;
    margin-top: 1;
}

AIPanel #ai-proposal {
    min-height: 4;
    border: round $accent;
}

AIPanel #ai-input {
    height: 30%;
    min-height: 6;
    max-height: 12;
    padding: 0 1;
    border: round $panel-lighten-2;
    margin-top: 1;
}

AIPanel .ai-buttons {
    height: 1;
}

AIPanel Button {
    min-width: 6;
    width: 1fr;
    padding: 0;
}

AIPanel #ai-apply {
    width: 2fr;
}

AIPanel #ai-function-details {
    height: auto;
    color: $accent;
}


/* -- AI diagnostic snapshot --------------------------------------------- */

AIDiagnosticsScreen {
    background: $background;
}

#ai-log-screen {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#ai-log-notice {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#ai-log-text {
    height: 1fr;
    border: round $accent;
}

#ai-log-buttons {
    height: 3;
}

#ai-log-buttons Button {
    margin-right: 1;
}

/* -- independently running AI chats ------------------------------------ */

#open-agents {
    width: auto;
    min-width: 8;
    margin: 1 0 0 1;
}

AgentsPane {
    height: 1fr;
    min-height: 5;
}

AgentsPane OptionList {
    height: 1fr;
    border: none;
    background: $surface;
    padding: 0 1;
}

#agents-summary {
    height: auto;
    padding: 0 1 1 1;
    background: $surface;
}

#agents-empty {
    height: 1fr;
    padding: 1;
    color: $text-muted;
    background: $surface;
}

#agents-hint {
    height: auto;
    padding: 0 1;
    color: $text-muted;
    background: $panel-darken-1;
}

AgentsPane .agents--busy {
    color: $accent;
    text-style: bold;
}

AgentsPane .agents--ready {
    color: $success;
    text-style: bold;
}

AgentsPane .agents--seen {
    color: $text-muted;
}

AgentsPane .agents--error {
    color: $error;
    text-style: bold;
}

AgentsPane .agents--cancelled {
    color: $warning;
}

AgentsPane OptionList > .option-list--option {
    padding: 0 0 1 0;
}

AgentsPane OptionList > .option-list--option-highlighted {
    color: $text;
    background: $primary 15%;
    text-style: none;
}

AgentsPane OptionList:focus > .option-list--option-highlighted {
    background: $primary 25%;
}

AgentsPane OptionList > .option-list--option-hover {
    background: $primary 10%;

}
