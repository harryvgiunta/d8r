/* anyQL's dark stylesheet: a data IDE in the terminal.
   Theme tokens come from `textual-dark`, so the app stays dark by design. */

Screen {
    background: $background;
    layers: base;
}

/* -- header ------------------------------------------------------------- */

#header {
    height: 3;
    padding: 0 1;
    background: $panel;
}

#app-title {
    width: auto;
    padding: 1 2 0 0;
    text-style: bold;
    color: $accent;
}

#header Select {
    width: 34;
    margin: 0 1 0 0;
}

#backend-pill {
    width: auto;
    height: 1;
    margin: 1 0 0 1;
    padding: 0 2;
    background: $accent 20%;
    color: $text;
}

/* -- body --------------------------------------------------------------- */

#body {
    height: 1fr;
}

#schema-pane {
    width: 36;
    border-right: solid $panel-lighten-2;
}

#schema-pane Tree {
    height: 1fr;
    background: $surface;
}

#work-bench {
    width: 1fr;
    layers: base overlay;
}

/* Every result tab hidden: the strip goes and the document takes the bench. */
#work-bench.no-tabs #result-tabs {
    display: none;
}

#work-bench.no-tabs #editor-pane {
    height: 1fr;
}

.pane-title {
    height: 1;
    padding: 0 1;
    background: $panel-darken-1;
    color: $text-muted;
    text-style: bold;
}

/* -- editor + palette --------------------------------------------------- */

#editor-pane {
    height: 45%;
    layers: base overlay;
}

#editor {
    height: 1fr;
    border: none;
    background: $surface;
}

#palette {
    layer: overlay;
    position: absolute;
    /* The palette re-places itself under the caret on every keystroke; these
       are only the values it starts from and the shape it keeps. */
    offset: 1 2;
    width: 62;
    max-height: 12;
    display: none;
    background: $panel;
    border: round $accent;
    padding: 0 1;
}

#palette.open {
    display: block;
}

/* -- results ------------------------------------------------------------ */

#result-tabs {
    height: 1fr;
}

#results-table {
    height: 1fr;
}

#results-error {
    display: none;
    height: auto;
    padding: 0 1;
    color: $error;
    text-style: bold;
}

#results-error.error {
    display: block;
}

#results-status {
    height: 1;
    padding: 0 1;
    background: $panel-darken-1;
    color: $text-muted;
}

#sql-text {
    height: 1fr;
    border: none;
    background: $surface;
}

#history-table {
    height: 1fr;
}

/* -- footer ------------------------------------------------------------- */

#footer {
    height: 2;
    background: $panel;
}

#keymap {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#status {
    height: 1;
    padding: 0 1;
    color: $text;
    text-style: bold;
}

/* -- add-source modal --------------------------------------------------- */

AddSourceModal {
    align: center middle;
    background: $background 60%;
}

#add-source {
    width: 74;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $accent;
}

#add-source-title {
    text-style: bold;
    color: $accent;
}

#add-source-note {
    color: $text-muted;
    padding: 0 0 1 0;
}

#add-source .field-label {
    padding: 1 0 0 0;
    color: $text-muted;
}

#add-source-message {
    height: auto;
    padding: 1 0 0 0;
    color: $text-muted;
}

#add-source-message.error {
    color: $error;
}

#add-source-buttons {
    height: auto;
    padding: 1 0 0 0;
}

#add-source-buttons Button {
    margin: 0 1 0 0;
}

/* -- settings ----------------------------------------------------------- */

SettingsScreen {
    align: center middle;
    background: $background;
}

#settings {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#settings-title {
    height: 1;
    text-style: bold;
    color: $accent;
}

#settings-crumb {
    height: 1;
    color: $text-muted;
}

#settings-menu {
    height: 1fr;
    background: $surface;
    border: round $panel-lighten-2;
}

#settings-hint {
    height: 1;
    padding: 1 0 0 0;
    color: $text-muted;
}
